<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="BoreGame.BoreMainWindow"
        Title="BoreGame"
        Width="900" Height="600"
        MinWidth="700" MinHeight="500">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#4A4A4A"/>
        </Style>
        
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#2A2A2A"/>
        </Style>
        
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#3A3A3A"/>
        </Style>
        
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#4A90E2"/>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- Фоновое изображение -->
        <Image x:Name="BackgroundImage" 
               Stretch="UniformToFill" 
               Opacity="0.8"/>
        
        <!-- Затемнение для лучшей читаемости -->
        <Panel Background="#CC000000"/>
        
        <!-- Основной контент -->
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            
            <!-- Левая панель с профилями -->
            <Border Grid.Column="1" 
                    Background="#1A1A1A" 
                    BorderBrush="#2A2A2A" 
                    BorderThickness="0,0,1,0"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Заголовок панели профилей -->
                    <TextBlock Grid.Row="0" 
                               Text="Профили" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               Margin="5,5,5,15"/>
                    
                    <!-- Список профилей -->
                    <ListBox Grid.Row="1" 
                             x:Name="ProfilesListBox"
                             Background="Transparent" 
                             BorderThickness="0"
                             SelectionChanged="ProfilesListBox_SelectionChanged">
                       
                    </ListBox>
                </Grid>
            </Border>
            
            <!-- Правая основная область -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Верхняя панель с кнопкой настроек -->
                <Border Grid.Row="0" 
                        Background="#1A1A1A" 
                        BorderBrush="#2A2A2A" 
                        BorderThickness="0,0,0,1"
                        Padding="15,10">
                    <Grid>
                        <TextBlock Text="BoreGame" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"/>
                        
                        <Button HorizontalAlignment="Right" 
                                VerticalAlignment="Center"
                                Content="⚙️ Настройки"
                                x:Name="SettingsButton"
                                Click="SettingsButton_Click"/>
                    </Grid>
                </Border>
                
                <!-- Центральная область с IP -->
                <Grid Grid.Row="1" Margin="30">
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center" 
                                Width="500">
                        
                        <TextBlock Text="IP-адрес сервера" 
                                   FontSize="14" 
                                   Foreground="#AAAAAA" 
                                   Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" 
                                     x:Name="IpTextBox"
                                     IsReadOnly="True" 
                                     Text="-"
                                     FontSize="16"
                                     Height="45"
                                     VerticalContentAlignment="Center"/>
                            
                            <Button Grid.Column="1" 
                                    Content="📋 Копировать" 
                                    Margin="10,0,0,0"
                                    Height="45"
                                    x:Name="CopyButton"
                                    Click="CopyButton_Click"/>
                        </Grid>
                        
                        <!-- Информация о выбранном профиле -->
                        <TextBlock x:Name="ProfileInfoText"
                                   Text="Выберите профиль для начала работы" 
                                   FontSize="12" 
                                   Foreground="#888888" 
                                   Margin="0,15,0,0"
                                   TextAlignment="Center"/>
                        
                        <Button Grid.Column="5" 
                                x:Name="ButtonOpenPort"
                                Content="🔓 Открыть порт"
                                HorizontalAlignment="Stretch" 
                               HorizontalContentAlignment="Center"
                                Margin="0,20,0,0"
                                Click="ButtonOpenPort_Click"/>
                    </StackPanel>
                </Grid>
                
                <!-- Нижняя панель с настройками сервера -->
                <Border Grid.Row="2" 
                        Background="#1A1A1A" 
                        BorderBrush="#2A2A2A" 
                        BorderThickness="0,1,0,0"
                        Padding="20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Порт -->
                        <TextBlock Grid.Column="0" 
                                   Text="Порт:" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        
                        <TextBox Grid.Column="1" 
                                 x:Name="PortTextBox"
                                 Text="25565"
                                 Height="35"
                                 VerticalContentAlignment="Center"/>
                        
                        <!-- Выбор сервера -->
                        <TextBlock Grid.Column="3" 
                                   Text="Сервер:" 
                                   Foreground="White" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        
                        <ComboBox Grid.Column="4" 
                                  x:Name="ServerComboBox"
                                  SelectedIndex="0"
                                  Height="35"
                                  MaxWidth="300"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="ServerComboBox_SelectionChanged">
                            <ComboBoxItem Content="Bore Classic"/>
                            <ComboBoxItem Content="Bore Digital"/>

                        </ComboBox>
                        
                    
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>